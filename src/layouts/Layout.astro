---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Control your Mac's volume with any MIDI controller. Perfect for anyone with a MIDI controller who wants convenient volume control.", ogImage = "og-image.png" } = Astro.props;

const siteUrl = import.meta.env.PROD ? 'https://kohlhofer.com/midiVol' : 'http://localhost:4321';
const fullOgImageUrl = siteUrl + '/' + ogImage;

// MIDI Volume Control's home is now fieldbw.com. These pages stay live and
// unchanged because the App Store listing still links to them, so redirecting
// is not an option — but each is a duplicate of a fieldbw page. A cross-domain
// canonical tells Google to index and credit the fieldbw version while
// visitors here are never moved.
//
// Keyed by path with the /midiVol base and any trailing slash stripped. A page
// not listed here emits no canonical rather than a wrong one.
const FIELDBW_EQUIVALENT = {
  '/': 'https://fieldbw.com/midi-volume/',
  '/terms': 'https://fieldbw.com/terms/midi-volume/',
  '/privacy': 'https://fieldbw.com/privacy/midi-volume/',
  // Support here is just an email link; /contact/ is its counterpart, since
  // fieldbw has no per-product support page.
  '/support': 'https://fieldbw.com/contact/',
};

const routeKey = Astro.url.pathname.replace(/^\/midiVol/, '').replace(/\/+$/, '') || '/';
const canonicalUrl = FIELDBW_EQUIVALENT[routeKey];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

  <!-- SEO Meta Tags -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImageUrl} />
  <meta property="og:image:alt" content="MIDI Volume Control App Icon" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl + Astro.url.pathname} />
  <meta property="og:site_name" content="MIDI Volume Control" />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImageUrl} />
  <meta name="twitter:image:alt" content="MIDI Volume Control App Icon" />
  
  <!-- Schema.org markup for app -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "MIDI Volume Control",
      "operatingSystem": "macOS",
      "applicationCategory": "UtilitiesApplication",
      "description": "Control your Mac's volume with any MIDI controller. Perfect for anyone with a MIDI controller who wants convenient volume control.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "downloadUrl": "https://apps.apple.com/us/app/midi-volume-control/id6752268711?mt=12",
      "requirements": "macOS 10.15 or later",
      "author": {
        "@type": "Organization",
        "name": "MIDI Volume Control"
      }
    }
  </script>
  
  <title>{title}</title>
  
</head>
<body class="bg-white text-gray-900 antialiased">
  <slot />
</body>
</html>